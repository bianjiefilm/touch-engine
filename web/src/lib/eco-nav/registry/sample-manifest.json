{
  "manifest_version": "app-registry/v1",
  "apps": [
    {
      "app_id": "orders",
      "display_name": "观澜接单（锚点应用，示例）",
      "enabled": true,
      "supported_source_kinds": [
        "order"
      ],
      "capabilities": [
        {
          "name": "order.handoff",
          "menu_visible": true,
          "requires_billing": false
        }
      ],
      "launch_targets": [
        {
          "target_id": "ti-orders-web",
          "kind": "launch",
          "url": "https://guanlan-order.example.invalid/launch"
        }
      ],
      "receipt_targets": [
        {
          "target_id": "rc-orders-main",
